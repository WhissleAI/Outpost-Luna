.DS_Store
.env
.venv/
__pycache__/
.pytest_cache/
node_modules/
frontend/dist/
.cache/
# NASA media: re-download with `make data`
backend/data/media
# Server TTS cache (GET /api/tts)
backend/data/tts_cache/
# NASA video cache in a dev checkout (app/video.py; the desktop app keeps it in the per-user folder)
backend/data/video_cache/

# Local embedder weights (model_server/tools/export_embedder.py) and the card-vector cache
model_server/models/
backend/data/cache/

# Camera gestures: the on-device vision runtime + models (frontend/tools/fetch_vision.mjs, sha256-pinned)
frontend/public/vision/
backend/data/turnlog/

# [polish 2] the dev checkout keeps the mission auto-save here (the desktop app: its per-user cache folder)
backend/data/saves/
backend/data/class/

# On-device learning in a dev checkout (backend/app/learn; the desktop app: its per-user cache folder)
backend/data/learning_state/
# videos only the video pack carries (backend/tools/video_catalog.py --derive, or a licensed drop-in): never in git
backend/data/video/local/

# Courses: the per-computer active course in a dev checkout (app/courses.py; the desktop app: its per-user cache folder)
backend/data/course_state/
