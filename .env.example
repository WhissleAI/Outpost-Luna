# Shared by backend/ and model_server/ (each reads ../.env). Everything is optional.

# Backend: LLM fallback for questions the gazetteer can't place.
ANTHROPIC_API_KEY=
# ASK_MODEL=claude-haiku-5-5
# MODEL_SERVER_URL=http://127.0.0.1:8200

# Model server: Arc Tagger build. Defaults use Head Start's copy so both apps run the same model.
# ARCTAG_LIB=~/Desktop/work/whissle/headstart/vendor/arctag/libarctag.dylib
# ARCTAG_MODEL_DIR=~/Desktop/work/whissle/headstart/models/arctag
# ARCTAG_POOL_SIZE=2

# Mission sim: NASA api.nasa.gov key for DONKI (solar storms). Free at https://api.nasa.gov
NASA_API_KEY=

# Voice (docs/VOICES.md). Model server: the OS's own offline voices on/off; engine auto (macOS say; Windows WinRT,
# then SAPI) | say | winrt | sapi; the kid's locale for ranking voices (default: the OS's).
OS_TTS=on
# OS_TTS_ENGINE=auto
# OS_TTS_LOCALE=en-US
# Backend: os (falls back to deepgram, then the browser voice) | deepgram
TTS_ENGINE=os
