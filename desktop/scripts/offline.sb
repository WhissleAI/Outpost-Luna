(version 1)
; Offline test profile for macOS sandbox-exec: everything allowed except network to anything but loopback.
;   sandbox-exec -f desktop/scripts/offline.sb "/Applications/Outpost Luna.app/Contents/MacOS/Outpost Luna"
; Children inherit the sandbox, so the model server and backend are offline too. DNS lookups fail as well.
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket))
