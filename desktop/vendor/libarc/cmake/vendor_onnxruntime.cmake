# The pinned ONNX Runtime next to libarc (issue #85). Reads onnxruntime.lock.json (the one pin), downloads the target
# platform's release archive once into ARC_ORT_CACHE (sha256-checked), extracts the runtime library and its licence
# files, checks the library's own sha256, and copies them to <build>/onnxruntime/ with onnxruntime.json
# ({version, lib, sha256, url}). The model server loads <libarc's folder>/onnxruntime/<lib> (model_server/app/nft2.py)
# and re-checks the sha256 at load. Nothing is linked: libarc still loads the runtime by path (ort_loader.c).
#
#   -DARC_ORT_VENDOR=OFF   skip (a dev build that runs on the pip wheel's copy: ARC_ORT_FROM_WHEEL=1 at run time)
#   -DARC_ORT_CACHE=dir    where archives are kept (default desktop/build/cache/onnxruntime, outside the build dir, so
#                          a clean rebuild does not download again)
#   -DARC_ORT_PLATFORM=..  override the lock key (darwin-arm64, windows-x64, linux-x64, linux-arm64)
option(ARC_ORT_VENDOR "Download the pinned ONNX Runtime next to libarc" ON)
set(ARC_ORT_CACHE "${CMAKE_CURRENT_SOURCE_DIR}/../../build/cache/onnxruntime" CACHE PATH "ONNX Runtime archive cache")
set(ARC_ORT_PLATFORM "" CACHE STRING "onnxruntime.lock.json platform key (empty: from the target)")

function(arc_vendor_onnxruntime)
  if(NOT ARC_ORT_VENDOR)
    message(STATUS "onnxruntime: not vendored (ARC_ORT_VENDOR=OFF); run the ear with ARC_ORT_FROM_WHEEL=1")
    return()
  endif()
  set(lockf "${CMAKE_CURRENT_SOURCE_DIR}/onnxruntime.lock.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lockf}")
  file(READ "${lockf}" lock)
  string(JSON ver GET "${lock}" version)

  set(key "${ARC_ORT_PLATFORM}")
  if(NOT key)
    if(CMAKE_OSX_ARCHITECTURES)
      set(arch "${CMAKE_OSX_ARCHITECTURES}")
    elseif(WIN32 AND CMAKE_GENERATOR_PLATFORM)   # Visual Studio -A x64 (the target, not the host)
      set(arch "${CMAKE_GENERATOR_PLATFORM}")
    else()
      set(arch "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    string(TOLOWER "${arch}" arch)
    if(arch MATCHES "^(arm64|aarch64)$")
      set(arch arm64)
    elseif(arch MATCHES "^(x86_64|amd64|x64)$")
      set(arch x64)
    endif()
    if(WIN32)
      set(key "windows-${arch}")
    elseif(APPLE)
      set(key "darwin-${arch}")
    else()
      set(key "linux-${arch}")
    endif()
  endif()
  string(JSON plat ERROR_VARIABLE nokey GET "${lock}" platforms "${key}")
  if(nokey)
    message(FATAL_ERROR "onnxruntime ${ver}: no pinned build for '${key}' in onnxruntime.lock.json. Add one, or "
                        "configure with -DARC_ORT_VENDOR=OFF and run the ear with ARC_ORT_FROM_WHEEL=1 (dev only).")
  endif()
  string(JSON url GET "${plat}" url)
  string(JSON sha GET "${plat}" sha256)
  string(JSON root GET "${plat}" root)
  string(JSON lib GET "${plat}" lib)
  string(JSON lib_sha GET "${plat}" lib_sha256)
  get_filename_component(lib_name "${lib}" NAME)
  get_filename_component(archive_name "${url}" NAME)

  set(out "${CMAKE_BINARY_DIR}/onnxruntime")
  if(EXISTS "${out}/${lib_name}")
    file(SHA256 "${out}/${lib_name}" have)
    if(have STREQUAL lib_sha)
      message(STATUS "onnxruntime ${ver} (${key}): ${out}/${lib_name}")
      return()
    endif()
  endif()

  file(MAKE_DIRECTORY "${ARC_ORT_CACHE}")
  set(archive "${ARC_ORT_CACHE}/${archive_name}")
  set(ok FALSE)
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" have)
    if(have STREQUAL sha)
      set(ok TRUE)
    else()
      file(REMOVE "${archive}")
    endif()
  endif()
  if(NOT ok)
    message(STATUS "onnxruntime ${ver} (${key}): downloading ${url}")
    file(DOWNLOAD "${url}" "${archive}.part" EXPECTED_HASH SHA256=${sha} TLS_VERIFY ON STATUS st)
    list(GET st 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${archive}.part")
      message(FATAL_ERROR "onnxruntime ${ver}: download of ${url} failed: ${st}")
    endif()
    file(RENAME "${archive}.part" "${archive}")
  endif()

  set(tmp "${CMAKE_BINARY_DIR}/onnxruntime-extract")
  file(REMOVE_RECURSE "${tmp}")
  set(members "${root}/${lib}")
  string(JSON n LENGTH "${lock}" licence)
  math(EXPR last "${n} - 1")
  set(lic_files "")
  foreach(i RANGE ${last})
    string(JSON f GET "${lock}" licence ${i})
    list(APPEND members "${root}/${f}")
    list(APPEND lic_files "${f}")
  endforeach()
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${tmp}" PATTERNS ${members})
  if(NOT EXISTS "${tmp}/${root}/${lib}")
    message(FATAL_ERROR "onnxruntime ${ver}: ${root}/${lib} is not in ${archive}")
  endif()
  file(SHA256 "${tmp}/${root}/${lib}" have)
  if(NOT have STREQUAL lib_sha)
    message(FATAL_ERROR "onnxruntime ${ver}: ${lib} has sha256 ${have}, the lock says ${lib_sha}")
  endif()
  file(REMOVE_RECURSE "${out}")
  file(MAKE_DIRECTORY "${out}")
  file(COPY_FILE "${tmp}/${root}/${lib}" "${out}/${lib_name}")
  foreach(f ${lic_files})
    get_filename_component(fn "${f}" NAME)
    file(COPY_FILE "${tmp}/${root}/${f}" "${out}/${fn}")
  endforeach()
  file(REMOVE_RECURSE "${tmp}")
  file(WRITE "${out}/onnxruntime.json"
       "{\"version\": \"${ver}\", \"platform\": \"${key}\", \"lib\": \"${lib_name}\", \"sha256\": \"${lib_sha}\", \"url\": \"${url}\"}\n")
  message(STATUS "onnxruntime ${ver} (${key}): ${out}/${lib_name} (sha256 ok)")
endfunction()
