# The pinned ONNX Runtime next to libarc (issue #85). Reads onnxruntime.lock.json (the one pin), downloads the target
# platform's archive once into ARC_ORT_CACHE (sha256-checked), trying the platform's "sources" in order (GitHub, NuGet,
# our Dropbox mirror: github.com/microsoft/onnxruntime went offline in Nov 2026), extracts the runtime library and its
# licence files, checks the library's own sha256 (the one lib_sha256, whichever source it came from), and copies them
# to <build>/onnxruntime/ with onnxruntime.json ({version, lib, sha256, url}). The model server loads <libarc's folder>/onnxruntime/<lib> (model_server/app/nft2.py)
# and re-checks the sha256 at load. Nothing is linked: libarc still loads the runtime by path (ort_loader.c).
#
#   -DARC_ORT_VENDOR=OFF   skip (a dev build that runs on the pip wheel's copy: ARC_ORT_FROM_WHEEL=1 at run time)
#   -DARC_ORT_CACHE=dir    where archives are kept (default desktop/build/cache/onnxruntime, outside the build dir, so
#                          a clean rebuild does not download again). An archive put here by hand under its url's file
#                          name (any listed source, exact bytes) is used without any download.
#   -DARC_ORT_PLATFORM=..  override the lock key (darwin-arm64, windows-x64, linux-x64, linux-arm64)
option(ARC_ORT_VENDOR "Download the pinned ONNX Runtime next to libarc" ON)
set(ARC_ORT_CACHE "${CMAKE_CURRENT_SOURCE_DIR}/../../build/cache/onnxruntime" CACHE PATH "ONNX Runtime archive cache")
set(ARC_ORT_PLATFORM "" CACHE STRING "onnxruntime.lock.json platform key (empty: from the target)")

function(arc_vendor_onnxruntime)
  if(NOT ARC_ORT_VENDOR)
    message(STATUS "onnxruntime: not vendored (ARC_ORT_VENDOR=OFF); run the ear with ARC_ORT_FROM_WHEEL=1")
    return()
  endif()
  set(lockf "${CMAKE_CURRENT_SOURCE_DIR}/onnxruntime.lock.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lockf}")
  file(READ "${lockf}" lock)
  string(JSON ver GET "${lock}" version)

  set(key "${ARC_ORT_PLATFORM}")
  if(NOT key)
    if(CMAKE_OSX_ARCHITECTURES)
      set(arch "${CMAKE_OSX_ARCHITECTURES}")
    elseif(WIN32 AND CMAKE_GENERATOR_PLATFORM)   # Visual Studio -A x64 (the target, not the host)
      set(arch "${CMAKE_GENERATOR_PLATFORM}")
    else()
      set(arch "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    string(TOLOWER "${arch}" arch)
    if(arch MATCHES "^(arm64|aarch64)$")
      set(arch arm64)
    elseif(arch MATCHES "^(x86_64|amd64|x64)$")
      set(arch x64)
    endif()
    if(WIN32)
      set(key "windows-${arch}")
    elseif(APPLE)
      set(key "darwin-${arch}")
    else()
      set(key "linux-${arch}")
    endif()
  endif()
  string(JSON plat ERROR_VARIABLE nokey GET "${lock}" platforms "${key}")
  if(nokey)
    message(FATAL_ERROR "onnxruntime ${ver}: no pinned build for '${key}' in onnxruntime.lock.json. Add one, or "
                        "configure with -DARC_ORT_VENDOR=OFF and run the ear with ARC_ORT_FROM_WHEEL=1 (dev only).")
  endif()
  string(JSON lib GET "${plat}" lib)
  string(JSON lib_sha GET "${plat}" lib_sha256)
  get_filename_component(lib_name "${lib}" NAME)

  set(out "${CMAKE_BINARY_DIR}/onnxruntime")
  if(EXISTS "${out}/${lib_name}")
    file(SHA256 "${out}/${lib_name}" have)
    if(have STREQUAL lib_sha)
      message(STATUS "onnxruntime ${ver} (${key}): ${out}/${lib_name}")
      return()
    endif()
  endif()

  # The ordered sources: "sources" (github, nuget, our mirror, ...), or the entry itself (a lock without "sources").
  string(JSON nsrc ERROR_VARIABLE nosources LENGTH "${plat}" sources)
  if(nosources OR nsrc EQUAL 0)
    set(srcs "${plat}")
    set(nsrc 1)
  else()
    set(srcs "")
    math(EXPR lastsrc "${nsrc} - 1")
    foreach(i RANGE ${lastsrc})
      string(JSON s GET "${plat}" sources ${i})
      list(APPEND srcs "${s}")   # a JSON object: no ';' in any of our fields
    endforeach()
  endif()

  # 1) an archive already in the cache (any source, sha256-checked) 2) download each source in order.
  file(MAKE_DIRECTORY "${ARC_ORT_CACHE}")
  set(chosen "")
  foreach(s IN LISTS srcs)
    string(JSON surl GET "${s}" url)
    string(JSON ssha GET "${s}" sha256)
    get_filename_component(sname "${surl}" NAME)
    if(EXISTS "${ARC_ORT_CACHE}/${sname}")
      file(SHA256 "${ARC_ORT_CACHE}/${sname}" have)
      if(have STREQUAL ssha)
        set(chosen "${s}")
        break()
      endif()
      file(REMOVE "${ARC_ORT_CACHE}/${sname}")
    endif()
  endforeach()
  set(tried "")
  if(NOT chosen)
    foreach(s IN LISTS srcs)
      string(JSON surl GET "${s}" url)
      string(JSON ssha GET "${s}" sha256)
      get_filename_component(sname "${surl}" NAME)
      set(part "${ARC_ORT_CACHE}/${sname}.part")
      message(STATUS "onnxruntime ${ver} (${key}): downloading ${surl}")
      file(DOWNLOAD "${surl}" "${part}" TLS_VERIFY ON STATUS st)
      list(GET st 0 code)
      if(code EQUAL 0)
        file(SHA256 "${part}" have)
        if(have STREQUAL ssha)
          file(RENAME "${part}" "${ARC_ORT_CACHE}/${sname}")
          set(chosen "${s}")
          break()
        endif()
        set(st "sha256 ${have}, the lock says ${ssha}")
      endif()
      file(REMOVE "${part}")
      message(STATUS "onnxruntime ${ver} (${key}): ${surl} failed (${st}); trying the next source")
      string(APPEND tried "\n  ${surl}: ${st}")
    endforeach()
  endif()
  if(NOT chosen)
    message(FATAL_ERROR "onnxruntime ${ver} (${key}): no source in onnxruntime.lock.json could be fetched:${tried}\n"
                        "Put the archive (exact bytes, any listed source) in ${ARC_ORT_CACHE}/ and configure again.")
  endif()
  string(JSON url GET "${chosen}" url)
  string(JSON root GET "${chosen}" root)
  string(JSON slib GET "${chosen}" lib)
  get_filename_component(archive_name "${url}" NAME)
  set(archive "${ARC_ORT_CACHE}/${archive_name}")
  set(pre "")
  if(root)
    set(pre "${root}/")
  endif()
  string(JSON licence ERROR_VARIABLE nolic GET "${chosen}" licence)   # a source may keep its licence files elsewhere
  if(nolic)
    string(JSON licence GET "${lock}" licence)
  endif()

  set(tmp "${CMAKE_BINARY_DIR}/onnxruntime-extract")
  file(REMOVE_RECURSE "${tmp}")
  set(members "${pre}${slib}")
  string(JSON n LENGTH "${licence}")
  math(EXPR last "${n} - 1")
  set(lic_files "")
  foreach(i RANGE ${last})
    string(JSON f GET "${licence}" ${i})
    list(APPEND members "${pre}${f}")
    list(APPEND lic_files "${f}")
  endforeach()
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${tmp}" PATTERNS ${members})   # .tgz, .zip, .nupkg (a zip)
  if(NOT EXISTS "${tmp}/${pre}${slib}")
    message(FATAL_ERROR "onnxruntime ${ver}: ${pre}${slib} is not in ${archive}")
  endif()
  # The security check, whatever the source: the library bytes must be the pinned ones.
  file(SHA256 "${tmp}/${pre}${slib}" have)
  if(NOT have STREQUAL lib_sha)
    message(FATAL_ERROR "onnxruntime ${ver}: ${slib} from ${url} has sha256 ${have}, the lock says ${lib_sha}")
  endif()
  file(REMOVE_RECURSE "${out}")
  file(MAKE_DIRECTORY "${out}")
  file(COPY_FILE "${tmp}/${pre}${slib}" "${out}/${lib_name}")
  foreach(f ${lic_files})
    if(NOT EXISTS "${tmp}/${pre}${f}")
      message(FATAL_ERROR "onnxruntime ${ver}: licence file ${pre}${f} is not in ${archive}")
    endif()
    get_filename_component(fn "${f}" NAME)
    file(COPY_FILE "${tmp}/${pre}${f}" "${out}/${fn}")
  endforeach()
  file(REMOVE_RECURSE "${tmp}")
  file(WRITE "${out}/onnxruntime.json"
       "{\"version\": \"${ver}\", \"platform\": \"${key}\", \"lib\": \"${lib_name}\", \"sha256\": \"${lib_sha}\", \"url\": \"${url}\"}\n")
  message(STATUS "onnxruntime ${ver} (${key}): ${out}/${lib_name} from ${url} (sha256 ok)")
endfunction()
