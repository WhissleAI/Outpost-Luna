<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used once the app is Developer ID signed with the hardened runtime (docs/DESKTOP.md). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Camera & gestures (opt-in in Settings; docs/GESTURES.md). -->
  <key>com.apple.security.device.camera</key><true/>
  <!-- Electron's V8 and the embedded CPython / torch need these under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
